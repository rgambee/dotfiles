%YAML 1.2
---
# See http://www.sublimetext.com/docs/3/syntax.html
name: Python Log
first_line_match: '^([0-9:, -]{23}) - ([\w.\/() -]+:[0-9]+) - ([\w.-]+) - '
scope: text.python-log
contexts:
  main:
    - match: '^([0-9:, -]{23}) - ([\w.\/() -]+:[0-9]+) - ([\w.-]+) - '
      push: midline
      captures:
        1: string.quoted.other  # Timestamp
        2: keyword.control      # Filepath
        3: variable.function    # Logger name

    - match: '\bPR_ERROR\w*\b'
      scope: markup.deleted

  midline:
    - match: '(INFO) -'
      pop: true
      captures:
        1: entity.name.function

    - match: '(DEBUG) - (.*)$'
      pop: true
      captures:
        1: comment.line
        2: comment.line

    - match: '(WARNING) - (.*)$'
      pop: true
      captures:
        1: entity.name
        2: entity.name

    - match: '(ERROR) - (.*)$'
      pop: true
      captures:
        1: invalid.illegal
        2: markup.deleted
