%YAML 1.2
---
# See http://www.sublimetext.com/docs/3/syntax.html
name: Task Engine Log
first_line_match: '^[0-9:.T-]{23} (DEBUG|INFO|WARNING|ERROR|CRITICAL) '
scope: text.task-engine-log
contexts:
  main:
    - match: '^([0-9:.T-]{23})'
      push: timestamp
      captures:
        1: string.quoted.other

    # Indented lines, e.g. task arguments, but excluding resolution requests
    - match: '^\s+([^-\s][^>\s].*)$'
      captures:
          1: comment.line

  timestamp:
    # Special coloring for start and end of task
    - match: '(INFO) .*?(?:(Running [Tt]ask|Ending [Tt]ask):? "(\w+)").*?$'
      pop: true
      captures:
        1: variable.function
        2: entity.name.function
        3: keyword.control

    # Special coloring for resolution requests (continued below in another context)
    - match: '(INFO)\s+(Resolution Request Issued).*$'
      push: resolution
      captures:
        1: variable.function
        2: entity.name

    # Color lines according to log level
    - match: '(INFO) (.*)$'
      pop: true
      captures:
        1: variable.function
        2: text.plain

    - match: '(DEBUG) (.*)$'
      pop: true
      captures:
        1: comment.line
        2: comment.line

    - match: '(WARNING) (.*)$'
      pop: true
      captures:
        1: entity.name
        2: entity.name

    - match: '(ERROR|CRITICAL) (.*)$'
      pop: true
      captures:
        1: invalid.illegal
        2: markup.deleted

  resolution:
    - match: '^\s+->type: (\w+)\s*$'
      captures:
        1: markup.deleted

    - match: '^\s+->message: (.+)$'
      captures:
        1: entity.name

    - match: '^([0-9:.T-]{23})'
      pop: true
      captures:
        1: string.quoted.other
